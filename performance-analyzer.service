[Unit]
Description=Performance Analyzer Web Application
After=network.target

[Service]
Type=simple
User=performance-analyzer
Group=performance-analyzer
WorkingDirectory=/opt/performance-analyzer
Environment="PATH=/opt/performance-analyzer/venv/bin"
Environment="PYTHONPATH=/opt/performance-analyzer/backend"
ExecStart=/opt/performance-analyzer/venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10

# Security settings
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
