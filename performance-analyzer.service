[Unit]
Description=Performance Analyzer Web Application
After=network.target

[Service]
Type=simple
User=performance-analyzer
Group=performance-analyzer
WorkingDirectory=/opt/performance-analyzer/backend
Environment="PATH=/opt/performance-analyzer/venv/bin"
ExecStart=/opt/performance-analyzer/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/performance-analyzer/data /opt/performance-analyzer/.cache

[Install]
WantedBy=multi-user.target
